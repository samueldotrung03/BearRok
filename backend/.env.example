# Copy to .env and fill in. Never commit .env.

# Which model the agents run on is chosen in the app: Settings > Connect Claude, ChatGPT or Grok.
# Each runs through its app for the command line on this computer, on that account's subscription.
# The choice is saved next to the local data (.data/harness.json). Before anything is connected,
# a developer can name one here: claude, codex (ChatGPT) or cli (Grok).
# GROK_TRANSPORT=claude
# Where each app is, if it is not in a usual install folder:
# CLAUDE_CLI_BIN=  CODEX_CLI_BIN=  GROK_CLI_BIN=
# Default model per tier for each harness (normal: master, managers, validators, presentation; low: workers):
# CLAUDE_MODEL_NORMAL=claude-opus-5-5   CLAUDE_MODEL_LOW=claude-sonnet-5-5
# CODEX_MODEL_NORMAL=gpt-6.2-sol        CODEX_MODEL_LOW=gpt-6-luna
# GROK_CLI_MODEL_NORMAL=                GROK_CLI_MODEL_LOW=
# LIVE_MAX_JOBS=12            # worker jobs per run when using a CLI
# FEED_MIN=12                 # cards the feed should hold; the agents search again on their own until it does
# FEED_FILL_MAX_RUNS=4        # searches in a row they may start to get there
# GROK_CLI_ALWAYS_APPROVE=1   # let the CLI use web search without asking; see AGENT_SYSTEM.md before turning on
# GROK_CLI_CONCURRENCY=3

# xAI API key, for a deployed copy with no harness connected. Without it and without a harness the agents are simulated.
XAI_API_KEY=
# XAI_MODEL=grok-4.7
# Model per agent tier. Check the names and that each supports web search with JSON output on your account.
# XAI_MODEL_HIGH=grok-4.7      # not used by any agent level at the moment
# XAI_MODEL_NORMAL=grok-4.5    # master agent, search managers, validation agents, presentation manager
# XAI_MODEL_LOW=grok-4.3       # worker fleet (scouts, readers, application readers)
# Set to 1 to also give search workers the X search tool.
# XAI_X_SEARCH=1

# Google sign-in. Both values are on the Firebase console: Project settings > General > Your apps > Web app.
# They identify the project and are safe to share with the browser.
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
# FIREBASE_AUTH_DOMAIN=      # defaults to <project id>.firebaseapp.com

# Path to the Firebase service account JSON. Without it results go to .data/store.json.
FIREBASE_SERVICE_ACCOUNT=

# PORT=8787
# MAX_RESULTS_PER_TYPE=3

# A lasting Google connection for Calendar and Sheets: students connect once instead of every session.
# Make a "Desktop app" OAuth client in the Google Cloud project (APIs & Services > Credentials), download
# its JSON, and point this at it (or set GOOGLE_OAUTH_CLIENT_ID and GOOGLE_OAUTH_CLIENT_SECRET).
# GOOGLE_OAUTH_CLIENT_FILE=./google-oauth-client.json
