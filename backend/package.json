{
  "name": "bearrok-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "grok:check": "node --env-file-if-exists=.env scripts/grok-check.ts",
    "probe:live": "node --env-file-if-exists=.env scripts/live-probe.ts",
    "roadmap:check": "node --env-file-if-exists=.env scripts/roadmap-check.ts",
    "opportunities:backfill": "node --env-file-if-exists=.env scripts/opportunities-backfill.ts",
    "usage:report": "node --env-file-if-exists=.env scripts/usage-report.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@hono/node-server": "^2.1.9",
    "firebase-admin": "^14.5.1",
    "hono": "^4.13.19",
    "pg": "^8.23.1",
    "unpdf": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
